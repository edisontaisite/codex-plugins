{
  "mcpServers": {
    "porter": {
      "command": "./scripts/launch_porter_mcp",
      "args": ["./server.mjs"],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "HOME",
        "PATH",
        "TMPDIR",
        "XDG_CACHE_HOME",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 300
    }
  }
}
